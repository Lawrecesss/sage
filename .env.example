# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage
POSTGRES_PASSWORD=sage

# --- LLM (consumed by the openclaw container) ---
# OpenAI-compatible gateway (no trailing /v1 — OpenClaw appends it)
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
# Model id as the gateway knows it (GET $LLM_GATEWAY_URL/v1/models)
LLM_MODEL=sonnet4.5

# --- Agent runtime (OpenClaw + MCP) ---
OPENCLAW_TOKEN=
MCP_URL=http://mcp:9100/mcp

# --- Notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
