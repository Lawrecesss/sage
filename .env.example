# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage
POSTGRES_PASSWORD=sage

# --- LLM (OpenRouter, consumed by the openclaw container) ---
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# OpenRouter model slug (https://openrouter.ai/models)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Agent runtime (OpenClaw + MCP) ---
OPENCLAW_TOKEN=
MCP_URL=http://retail-mcp:9100/mcp

# --- Tenancy (web, dev-mode only — see ARCHITECTURE.md §9) ---
# Tenant used when a request has no x-tenant-id header.
DEFAULT_TENANT_ID=demo

# --- Notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cron monitor (platform/cron-monitor) ---
# How often the anomaly-monitor report runs, per active tenant. Must divide 24.
CRON_INTERVAL_HOURS=6

# --- Tracing (Langfuse Cloud, consumed by the openclaw container) ---
# Leave the keys blank to run without tracing. Region base URLs:
# EU https://cloud.langfuse.com | US https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Sends prompts, completions and tool payloads to Langfuse; false = metadata only
LANGFUSE_CAPTURE_CONTENT=true
LANGFUSE_SAMPLE_RATE=1
