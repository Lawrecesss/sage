# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage
POSTGRES_PASSWORD=sage           # used by docker-compose (prod: set a real one)

# --- LLM (organisers' Ollama-compatible endpoint, Bedrock-backed) ---
# Consumed by the `openclaw` container as its model provider — see
# agent/openclaw/openclaw.json5. Not read directly by any Python process.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5       # the only allowed model; exact string per the proxy

# --- Agent runtime (OpenClaw + MCP) ---
# See docs/decisions/0003-openclaw-agent-runtime.md. Internal network only —
# never expose these ports or this token publicly.
OPENCLAW_BASE_URL=http://openclaw:18789
OPENCLAW_TOKEN=                   # full operator credential for the gateway
OPENCLAW_AGENT_BRIEFING=sage-briefing
OPENCLAW_AGENT_ASK=sage-ask
MCP_URL=http://mcp:9100/mcp

# --- Deploy ---
SAGE_DOMAIN=                      # public hostname, e.g. sage.example.com

# --- Notifier (currently unwired — see ADR 0003) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Evals ---
SAGE_DATASET_SNAPSHOT=./var/data/snapshots/demo-v1

# --- Generator ---
SAGE_GEN_SEED=42
SAGE_GEN_MONTHS=12
