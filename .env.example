# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage

# --- AWS / Bedrock ---
AWS_REGION=us-west-2
BEDROCK_MODEL_ANALYST=anthropic.claude-opus-5
BEDROCK_MODEL_DEFAULT=anthropic.claude-sonnet-5
BEDROCK_MODEL_BULK=anthropic.claude-haiku-4-5

# --- Async agent runs ---
AGENT_QUEUE_URL=

# --- Object store (raw Parquet zone) ---
S3_RAW_BUCKET=

# --- Notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SES_SENDER=

# --- Evals ---
SAGE_DATASET_SNAPSHOT=./data/snapshots/demo-v1

# --- Generator ---
SAGE_GEN_SEED=42
SAGE_GEN_MONTHS=12
