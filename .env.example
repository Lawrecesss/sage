# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://sage:sage@localhost:5432/sage
POSTGRES_PASSWORD=sage           # used by docker-compose (prod: set a real one)

# --- LLM (organisers' Ollama-compatible endpoint, Bedrock-backed) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5       # the only allowed model; exact string per the proxy

# --- Deploy ---
SAGE_DOMAIN=                      # public hostname, e.g. sage.example.com

# --- Notifier ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Evals ---
SAGE_DATASET_SNAPSHOT=./data/snapshots/demo-v1

# --- Generator ---
SAGE_GEN_SEED=42
SAGE_GEN_MONTHS=12
