# For `pnpm dev` outside Docker. Copy to .env.local.
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=sage-dev-token

# Tenant used when a request has no x-tenant-id header (ARCHITECTURE.md §9).
# /api/chat looks this up in shared.tenants, so it needs DATABASE_URL and a seeded db.
DATABASE_URL=postgresql://sage:sage@127.0.0.1:5432/sage
DEFAULT_TENANT_ID=demo

# Dashboard/History/Signals/Metrics data source: "mock" (fixtures in src/mocks)
# until the signals/briefings tables and metric layer exist.
SAGE_DATA_SOURCE=mock

# Scheduled 6-hour report (lib/auto-reports.ts): on by default — every tenant with the retail
# module gets a report, with an anomaly scan, after each 00/06/12/18 slot closes. Needs
# DATABASE_URL and OpenClaw. "off" disables it (e.g. for `pnpm dev` without a backend).
# SAGE_AUTO_REPORTS=off
