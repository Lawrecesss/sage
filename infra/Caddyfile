# Caddy — TLS termination + reverse proxy for the single-instance deploy.
# SAGE_DOMAIN is read from the environment (set in /opt/sage/.env).
# Caddy fetches a Let's Encrypt cert automatically once DNS points at the instance
# and redirects http→https on its own.
#
# `mcp` and `openclaw` are deliberately NOT routed here — the OpenClaw gateway's
# bearer token is a full operator credential and neither service is built to
# face the public internet. They're reachable only on the internal docker
# network, from `api`. See docs/decisions/0003-openclaw-agent-runtime.md.

{$SAGE_DOMAIN} {
	encode gzip

	# API under /api/* — strip the prefix before proxying to FastAPI
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# everything else → the Next.js app
	handle {
		reverse_proxy web:3000
	}
}
