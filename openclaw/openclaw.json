// OpenClaw gateway config (JSON5). ${VAR}s are filled from the container env —
// see the `openclaw` service in docker-compose.yml.
//
// Runs OpenClaw as a headless agent loop behind an OpenAI-compatible HTTP API:
// web backend -> POST /v1/chat/completions -> agent loop -> retail MCP tools.
// No channels, no cron/heartbeat, no memory plugin, no built-in host tools.
{
  gateway: {
    mode: "local",
    bind: "lan", // listen on 0.0.0.0 inside the container; compose publishes to 127.0.0.1 only
    port: 18789,
    auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" },
    http: {
      endpoints: {
        chatCompletions: { enabled: true },
      },
    },
  },
  agents: {
    defaults: {
      model: { primary: "openrouter/${OPENROUTER_MODEL}" },
      // AGENTS.md / SOUL.md / IDENTITY.md are baked into the image (openclaw/workspace).
      workspace: "/opt/sage/workspace",
      skipBootstrap: true,
    },
  },
  // Only the retail MCP tools (+ session_status). `session_status` keeps the
  // allowlist non-empty at resolve time, before bundle-mcp tools have loaded.
  tools: { allow: ["session_status", "bundle-mcp"] },
  cron: { enabled: false }, // also disables scheduled heartbeats and memory dreaming
  plugins: {
    slots: { memory: "none" },
    // Ships disabled; without this the `diagnostics` block below is inert —
    // spans get created and sampled, but nothing ever exports them.
    entries: { "diagnostics-otel": { enabled: true } },
  },
  models: {
    mode: "merge",
    providers: {
      // OpenRouter's OpenAI-compatible endpoint.
      openrouter: {
        baseUrl: "https://openrouter.ai/api/v1",
        apiKey: "${OPENROUTER_API_KEY}",
        api: "openai-completions",
        timeoutSeconds: 300,
        models: [
          {
            id: "${OPENROUTER_MODEL}",
            name: "OpenRouter model",
            reasoning: false,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  // One entry per business module (ARCHITECTURE.md §4), not per tenant —
  // tenant scoping happens inside each tool call (tenant_id argument), not
  // via which MCP server is connected. This config is static/shared across
  // every tenant's requests; a future module (e.g. fnb) would be added as
  // another sibling key here once it has real data behind it.
  mcp: {
    servers: {
      retail: {
        url: "${MCP_URL}",
        transport: "streamable-http",
        enabled: true,
      },
    },
  },
  // Traces go to Langfuse Cloud over OTLP. The otel block is generated at
  // container start by render-otel.mjs (it derives the basic-auth header from
  // the Langfuse key pair, which `${VAR}` interpolation can't do — it only
  // substitutes into strings). No Langfuse keys in the env => tracing off.
  diagnostics: {
    enabled: true,
    otel: { $include: "./otel.json" },
  },
}
